# Copy to .env for local development. Vercel: set these in Project → Settings → Environment Variables.

# AGNI chat (server-side only — never VITE_-prefixed)
GEMINI_API_KEY=

# Agent37 Heat Response Co-Pilot (api/heat-agent.js) — server-side only, never VITE_-prefixed.
# Create an instance at agent37.com (Hermes template); the instance id is in its dashboard URL
# and its agent URL https://<id>.agent37.app. Without these the Co-Pilot returns the labelled
# rule-based fallback plan instead of an agent plan.
AGENT37_API_KEY=      # sk_live_...
AGENT37_INSTANCE_ID=  # e.g. ab12cd34ef

# Daily weather refresh cron (api/refresh-weather-cache.js)
CRON_SECRET=          # Vercel sends "Authorization: Bearer <CRON_SECRET>" with cron requests
GITHUB_TOKEN=         # fine-grained token with Contents: read/write on kkrrishagarwal/heatops

# Historic weather data — optional. When set, every refresh also writes one row per city to
# Postgres (tables are created automatically). Works with Neon / Vercel Postgres / Supabase /
# Railway / local. Without it, history still accumulates as daily snapshot files under
# public/data/history/ (tier 1) and the /api/weather-history endpoint reads those instead.
DATABASE_URL=         # e.g. postgres://user:pass@host/db?sslmode=require

# Openverse (second photo source after Wikimedia Commons) — optional, server-side/offline only,
# never VITE_-prefixed. Without these, scripts/buildOpenverseImages.mjs runs anonymously
# (Openverse allows 5 searches / hour, 100 / day). Register a client at
# https://api.openverse.org/v1/#tag/auth for 100 / minute.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Browser switches (safe to expose; no secrets): turn Openverse off entirely, or only its
# rationed live lookup (the pre-built manifest still applies).
VITE_OPENVERSE_ENABLED=true
VITE_OPENVERSE_LIVE=true

# ── Hackyard Build 2026 sponsor integrations (all server-side, never VITE_-prefixed) ──
# Hackyard LLM Gateway (team credits): OpenAI-compatible. Co-Pilot engine after Agent37; AGNI fallback.
LLM_GATEWAY_URL=          # base URL from the Hackyard portal, e.g. https://<gateway>/v1
LLM_GATEWAY_KEY=
LLM_GATEWAY_MODEL=        # optional, default gpt-4o-mini
# ElevenLabs: Hindi / English voice for the CAP alert (api/voice-alert.js)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=      # optional; default a multilingual premade voice
# Browser Use (Cloud API v4): agent reads live state demand from vidyutpravah.in (api/grid-demand.js); each run capped at $1
BROWSER_USE_API_KEY=
BROWSER_USE_PROXY_COUNTRY=in   # the portal loads only reliably from India; 'none' disables the proxy
