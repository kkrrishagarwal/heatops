{
  "outputDirectory": "dist",
  "functions": {
    "api/refresh-weather-cache.js": {
      "maxDuration": 60,
      "includeFiles": "src/data/cityCoordinates.json"
    },
    "api/heat-agent.js": {
      "maxDuration": 60
    },
    "api/weather-history.js": {
      "includeFiles": "public/data/history/**"
    },
    "api/refresh-weather-cache-retry.js": {
      "maxDuration": 60,
      "includeFiles": "src/data/cityCoordinates.json"
    },
    "api/osm-grid.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/refresh-weather-cache",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/refresh-weather-cache-retry",
      "schedule": "30 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/(.*).geojson",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
